# Kopier til ".env" lokalt, og sett de samme verdiene i Vercel
# (Settings → Environment Variables). IKKE commit ekte nøkler.

# API-nøkkel fra https://resend.com (Settings → API Keys)
RESEND_API_KEY=re_din_nokkel_her

# Avsenderadresse. Domenet må være verifisert i Resend.
# Før domeneverifisering kan du teste med: Aktuarium <onboarding@resend.dev>
MAIL_FROM=Aktuarium <rapport@dittdomene.no>

# Valgfritt: lås CORS til din side. Default er "*".
# ALLOW_ORIGIN=https://sporg-no.github.io
